# ====================================================
# NEON POSTGRESQL DATABASE
# ====================================================
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.c-9.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.c-9.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH=production
NEON_BRANCH_ID=br-calm-resonance-begbpod9
NEON_FUNCTION_HOST_SUFFIX=.compute.c-9.us-east-2.aws.neon.tech

# ====================================================
# NEON REALTIME
# ====================================================
NEON_REALTIME_URL=wss://<host>.rt.c-9.us-east-2.aws.neon.tech/
NEON_REALTIME_SECRET="<neon_realtime_secret>"

# ====================================================
# NEON S3-COMPATIBLE OBJECT STORAGE
# ====================================================
AWS_ENDPOINT_URL_S3="https://<branch>.storage.c-9.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="<aws_access_key_id>"
AWS_SECRET_ACCESS_KEY="<aws_secret_access_key>"
AWS_REGION="us-east-2"
S3_BUCKET_NAME="nattukootam-media"

# ====================================================
# CLERK AUTHENTICATION
# ====================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<clerk_publishable_key>"
CLERK_SECRET_KEY="<clerk_secret_key>"

# ====================================================
# CLOUDINARY MEDIA STORAGE
# ====================================================
CLOUDINARY_CLOUD_NAME="<cloudinary_cloud_name>"
CLOUDINARY_API_KEY="<cloudinary_api_key>"
CLOUDINARY_API_SECRET="<cloudinary_api_secret>"

# ====================================================
# APPLICATION & JWT SECRETS
# ====================================================
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET="naatukoottam-jwt-secret-key-change-in-prod"
JWT_REFRESH_SECRET="naatukoottam-jwt-refresh-secret-key-change-in-prod"

